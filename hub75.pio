.pio_version 0

.program hub75_row
.side_set 2

; row selection, latch, and oe pulsing
; side set bits: lat,oe

.wrap_target
    out pins, 5 [7] side 0b10 ; deassert oe, output sel
    out x, 27   [7] side 0b11 ; pulse lat, get oe pulse width
pulse_loop:
    jmp x-- pulse_loop side 0b00 ; assert oe for x+1 cycles
    in x, 32 side 0b10 ; output 
.wrap

% c-sdk {
static inline void hub75_row_program_init(PIO pio, uint offset, uint sm, uint sel_base_pin, uint lat_oe_base_pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, sel_base_pin, 4, true);
    pio_sm_set_consecutive_pindirs(pio, sm, lat_oe_base_pin, 2, true);
    for (uint i = sel_base_pin; i < sel_base_pin + 4; i ++) {
        pio_gpio_init(pio, i); // each rgb0 and rgb1 pin
    }
    pio_gpio_init(pio, lat_oe_base_pin); // lat pin
    pio_gpio_init(pio, lat_oe_base_pin + 1); // oe pin

    pio_sm_config cfg = hub75_row_program_get_default_config(offset);
    sm_config_set_out_pins(&cfg, sel_base_pin, 4); // rgb0 and rgb1 pins
    sm_config_set_sideset_pins(&cfg, lat_oe_base_pin); // lat and oe pins
    sm_config_set_out_shift(&cfg, true, true, 32);
    sm_config_set_out_shift(&cfg, true, true, 32);
    pio_sm_init(pio, sm, offset, &cfg);
    pio_sm_set_enabled(pio, sm, true);
}
%}

.program hub75_pixel
.side_set 1
.define BIT_PLANES 10

; pixel clocking

public entry_point:
.wrap_target
public shift0:
    pull                    side 0
    in osr, 1               side 0 ; red0 bit
    out null, BIT_PLANES    side 0 ; skip to next
    in osr, 1               side 0 ; green0 bit
    out null, BIT_PLANES    side 0 ; skip to next
    in osr, 1               side 0 ; blue0 bit
    out null, 32            side 0 ; skip rest
public shift1:
    pull                    side 0
    in osr, 1               side 0 ; red0 bit, clk in rgb0
    out null, BIT_PLANES    side 0 ; skip to next
    in osr, 1               side 0 ; green0 bit
    out null, BIT_PLANES    side 0 ; skip to next
    in osr, 1               side 0 ; blue0 bit
    out null, 32 [7]        side 1 ; skip rest, clk edge
    ; out null, 0 [7]         side 1 ; hold clk
    mov pins, ::isr         side 0 
.wrap

% c-sdk {
static inline void hub75_pixel_program_init(PIO pio, uint offset, uint sm, uint rgb_base_pin, uint clk_pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, rgb_base_pin, 6, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 1, true);
    for (uint i = rgb_base_pin; i < rgb_base_pin + 6; i ++) {
        pio_gpio_init(pio, i);
    }
    pio_gpio_init(pio, clk_pin);

    pio_sm_config cfg = hub75_pixel_program_get_default_config(offset);
    sm_config_set_out_pins(&cfg, rgb_base_pin, 6);
    sm_config_set_sideset_pins(&cfg, clk_pin);
    sm_config_set_out_shift(&cfg, true, true, 32);
    sm_config_set_in_shift(&cfg, false, false, 32);
    sm_config_set_fifo_join(&cfg, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &cfg);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void hub75_pixel_set_shift(PIO pio, uint sm, uint offset, uint shift_amount) {
    uint16_t instr;
    if (shift_amount == 0) {
        instr = pio_encode_pull(false, true);
    } else {
        instr = pio_encode_out(pio_null, shift_amount);
    }
    pio->instr_mem[offset + hub75_pixel_offset_shift0] = instr;
    pio->instr_mem[offset + hub75_pixel_offset_shift1] = instr;
}
%}